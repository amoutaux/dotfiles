// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "bottom"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "buffer_font_size": 15,
  "centered_layout": {
    "left_padding": 0.4,
    "right_padding":0.2
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "project_panel": {
    "dock": "left"
  },
  "relative_line_numbers": "enabled",
  "session": {
    "trust_all_worktrees": true
  },
  "tab_bar": {
    "show": true
  },
  "terminal": {
    "font_family": "DroidSansMono Nerd Font"
  },
  "theme": {
    "mode": "light",
    "light": "Gruvbox Material Light Hard",
    "dark": "Gruvbox Material Dark Hard",
  },
  "theme_overrides": {
    "Gruvbox Material Light Hard": {
      "background": "#FAF9F5",
      "editor.background": "#FAF9F5",
      "editor.gutter.background": "#FAF9F5",
      "editor.line_number": "#000000",
      "editor.active_line_number": "#000000",
      "editor.active_line.background": "#FAF9F5",
      "element.background": "#FAF9F5",
      "element.selection_background": "#FAF9F5",
      "elevated_surface.background": "#FAF9F5",
      "panel.overlay_background": "#FAF9F5",
      "tab.inactive_background": "#FAF9F5",
      "panel.background": "#FAF9F5",
      "surface.background": "#FAF9F5",
      "tab_bar.background": "#FAF9F5",
      "toolbar.background": "#FAF9F5",
      "status_bar.background": "#FAF9F5",
      "terminal.background": "#FAF9F5",

    }
  },
  "ui_font_size": 16,
  "vim_mode": true,
}
